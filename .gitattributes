# third_party 大二进制走 Git LFS —— GitHub 单文件 >100MB 直接拒收
# (libManusSDK.so 138M、ffprobe.exe 121M、libManusSDK_Integrated.so 112M),
# 50–100MB 也会告警(ffmpeg.exe 88M)。
third_party/**/*.exe   filter=lfs diff=lfs merge=lfs -text
third_party/**/*.dll   filter=lfs diff=lfs merge=lfs -text
third_party/**/*.so    filter=lfs diff=lfs merge=lfs -text

# 预防后续放进来的其他大二进制类型
third_party/**/*.lib   filter=lfs diff=lfs merge=lfs -text
third_party/**/*.a     filter=lfs diff=lfs merge=lfs -text
third_party/**/*.pdb   filter=lfs diff=lfs merge=lfs -text
third_party/**/*.dylib filter=lfs diff=lfs merge=lfs -text
third_party/**/*.zip   filter=lfs diff=lfs merge=lfs -text
third_party/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
